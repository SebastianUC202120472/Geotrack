# =============================================================================
# Variables del asistente virtual con IA (Idea 1). Copia estas lineas al .env de la
# RAIZ del repositorio (el que lee docker-compose). Nunca subas claves al repositorio.
# =============================================================================

# Interruptor del modulo: false = apagado (el widget no aparece y el resto sigue igual).
ASISTENTE_ENABLED=true

# Orden de respaldo: si uno llega a su limite, falla o no empieza a responder a tiempo, se
# usa el siguiente. Nombres: gemini, groq, groq_respaldo, openrouter, ollama (los que no
# tengan clave se omiten solos). Para usar Groq como principal:
# ASISTENTE_PROVEEDORES=groq,groq_respaldo,gemini,openrouter,ollama
ASISTENTE_PROVEEDORES=gemini,groq,groq_respaldo,openrouter,ollama

# Google AI Studio -> "Get API key" (capa gratuita: SOLO datos de prueba).
GEMINI_API_KEY=
# GEMINI_MODELO=gemini-3.5-flash-lite

# console.groq.com -> API Keys. Tambien se usa para transcribir la voz (Whisper).
GROQ_API_KEY=
# GROQ_MODELO=openai/gpt-oss-120b
# Segundo modelo de Groq con la MISMA clave (Groq limita por modelo). Vacio = sin respaldo.
# GROQ_MODELO_RESPALDO=openai/gpt-oss-20b

# openrouter.ai -> Keys. Los modelos que terminan en ":free" no cuestan.
OPENROUTER_API_KEY=
# OPENROUTER_MODELO=meta-llama/llama-3.3-70b-instruct:free

# Ollama en la propia PC (sin clave). Desde Docker en Windows/Mac:
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=
# OLLAMA_MODELO=qwen2.5:7b

# Tiempos de espera con la IA, en segundos (opcionales). PRIMER_FRAGMENTO: plazo para que el
# proveedor empiece a responder antes de pasar al siguiente. TIMEOUT: espera maxima entre fragmentos.
# ASISTENTE_IA_PRIMER_FRAGMENTO_SEG=20
# ASISTENTE_IA_TIMEOUT_SEG=20

# Limites de uso por usuario (opcionales).
# ASISTENTE_MENSAJES_POR_MINUTO=10
# ASISTENTE_MENSAJES_POR_DIA=200
# ASISTENTE_VOZ_MAX_SEG=60
