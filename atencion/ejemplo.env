# =============================================================================
# Variables del asistente de atencion al cliente (Idea 2). Copia estas lineas al .env de la
# RAIZ del repositorio (el que lee docker-compose). Nunca subas claves al repositorio.
# Es independiente del asistente del panel (ASISTENTE_ENABLED): cada uno se apaga solo.
# =============================================================================

# Interruptor del modulo: false = apagado (el widget no aparece y el resto sigue igual).
ATENCION_ENABLED=true

# Secreto para firmar los tokens de conversacion y las huellas de IP (32+ caracteres aleatorios).
# Generalo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
ATENCION_SECRETO_CONVERSACION=

# Origenes del sitio que pueden usar el chat (CORS + control de Origin). En produccion, el dominio real.
ATENCION_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Dominios a los que el asistente puede enlazar (cualquier otro enlace se quita).
# ATENCION_DOMINIOS_PERMITIDOS=sava.pe,www.sava.pe

# Orden de respaldo de los proveedores de IA (los que no tengan clave se omiten solos).
ATENCION_PROVEEDORES=groq,groq_respaldo,gemini,openrouter,ollama

# Claves propias del modulo. VACIAS = se usan GEMINI_API_KEY, GROQ_API_KEY y OPENROUTER_API_KEY
# del asistente del panel (decision del gerente: por ahora se comparten).
ATENCION_GEMINI_API_KEY=
ATENCION_GROQ_API_KEY=
ATENCION_OPENROUTER_API_KEY=
# ATENCION_GEMINI_MODELO=gemini-3.5-flash-lite
# ATENCION_GROQ_MODELO=openai/gpt-oss-120b
# ATENCION_GROQ_MODELO_RESPALDO=openai/gpt-oss-20b
# ATENCION_OPENROUTER_MODELO=nvidia/nemotron-3.5-super-vl:free
# Ollama: OPCIONAL y apagado por defecto (produccion en la nube usa Groq, Gemini y OpenRouter).
# Solo para pruebas locales con GPU; se activa al poner la URL. Modelo de 7B (RTX 3060 12 GB) o
# de 3B (GTX 1650 Super). Desde Docker en Windows/Mac:
# ATENCION_OLLAMA_URL=http://host.docker.internal:11434
# ATENCION_OLLAMA_MODELO=qwen2.5:7b
# ATENCION_OLLAMA_MODELO=qwen2.5:3b
# ATENCION_OLLAMA_TIMEOUT_SEG=120

# Limites anti-abuso (opcionales).
# ATENCION_MAX_CARACTERES=500
# ATENCION_CONVERSACIONES_POR_HORA_IP=10
# ATENCION_MENSAJES_POR_MINUTO_IP=8
# ATENCION_MENSAJES_POR_DIA_IP=80
# ATENCION_TURNOS_POR_CONVERSACION=30
# Tope diario de mensajes con IA para todo el sitio; al llegar, responde solo con la base de conocimiento.
# ATENCION_TOPE_DIARIO_GLOBAL=1500

# Privacidad (Ley 29733): dias que se guardan las conversaciones antes de borrarse solas.
# ATENCION_RETENCION_DIAS=30

# Portal (semana 14): intentos de verificacion por DNI y solicitudes (reprogramar/contacto) por conversacion.
# ATENCION_VERIFICACIONES_POR_CONVERSACION=6
# ATENCION_ACCIONES_POR_CONVERSACION=3
# ATENCION_PROPUESTA_VENCE_SEG=600
# Mensajes seguidos sin resolver antes de ofrecer hablar con una persona.
# ATENCION_DERIVAR_TRAS_FALLOS=2

# Voz: Whisper de Groq (usa la clave de Groq). Sin clave, el widget usa el dictado del navegador.
# ATENCION_VOZ_MAX_SEG=60
# ATENCION_VOZ_MAX_KB=1024
# ATENCION_AUDIOS_POR_MINUTO_IP=4
# ATENCION_AUDIOS_POR_CONVERSACION=10
